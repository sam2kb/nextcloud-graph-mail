{
  "name": "sam2kb/graph-mail",
  "description": "Microsoft Graph transport for Nextcloud system mail",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^11.5",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "OCA\\GraphMail\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\GraphMail\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check-style": "php-cs-fixer fix --config=tools/php-cs-fixer.php --dry-run",
    "format": "php-cs-fixer fix --config=tools/php-cs-fixer.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
